#: decoder_modules/radio/src/radio_module.h:264
msgid ""
"Reduces impulse noise and interference\n"
"Useful for suppressing power line noise, ignition noise\n"
"Higher values = more aggressive noise blanking"
msgstr ""
"抑制脉冲噪声和干扰\n"
"适用于削弱电源线噪声、点火噪声\n"
"数值越高 = 噪声抑制越强"

#: decoder_modules/radio/src/radio_module.h:282
msgid "Squelch##_radio_sqelch_ena_"
msgstr "静噪##_radio_sqelch_ena_"

#: decoder_modules/radio/src/radio_module.h:286
msgid ""
"Mutes audio when signal is below threshold (dBFS)\n"
"Prevents listening to noise when no signal is present\n"
"Lower values = more sensitive, higher values = less sensitive"
msgstr ""
"当信号低于阈值(dBFS)时静音\n"
"防止在无信号时收听噪声\n"
"数值越低 = 灵敏度越高，数值越高 = 灵敏度越低"

#: decoder_modules/radio/src/radio_module.h:303
msgid "IF Noise Reduction##_radio_fmifnr_ena_"
msgstr "中频降噪##_radio_fmifnr_ena_"

